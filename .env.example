# AI Provider Keys (set at least ONE in local .env, Cloud Run, or Cloudflare Workers Variables & Secrets)
# Free-tier providers are automatically prioritized first (GEMINI_API_KEY -> GROQ_API_KEY -> DEEPSEEK_API_KEY)
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Optional paid fallback (set AI_PRIMARY_PROVIDER="deepseek" only if you intentionally want DeepSeek first)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
# AI_PRIMARY_PROVIDER="gemini"
# DISABLE_CLOUD_AI="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SERVER_URL: Optional external backend URL (leave unset on Cloudflare Workers so built-in /functions/api handles requests at the edge).
# VITE_SERVER_URL="https://ais-dev-esnqt5uw3zvrzqrsduwy5u-543927946609.us-west2.run.app"

